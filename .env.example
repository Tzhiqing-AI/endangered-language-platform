# =============================================================================
# 环境变量示例（复制为 .env 后按需修改；.env 不要提交到 Git）
# 说明：settings.py 读取以下变量，未配置时使用括号内默认值。
# =============================================================================

# -----------------------------------------------------------------------------
# Django 安全配置
# -----------------------------------------------------------------------------
# 必填（生产环境）：必须是非 django-insecure- 开头的强随机串
DJANGO_SECRET_KEY=your-secret-key-here-change-in-production
# 本地开发需显式设为 True；生产保持 False
DJANGO_DEBUG=True
# 逗号分隔（默认 localhost,127.0.0.1）
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# 可选：HTTPS 部署时的可信来源，逗号分隔（默认空）
DJANGO_CSRF_TRUSTED_ORIGINS=
# 可选：仅在可信反向代理后开启，普通部署保持 False（默认 False）
TRUST_PROXY_HEADERS=False
# 可选：HTTPS 相关开关（默认：DEBUG=False 时开启 SSL 跳转与 Secure Cookie）
DJANGO_SECURE_SSL_REDIRECT=
DJANGO_SECURE_COOKIES=
# 可选：HSTS 秒数（默认生产 31536000，调试为 0）
DJANGO_HSTS_SECONDS=

# 可选：唯一可调整管理员角色的引导账号（留空则网页端不能提升管理员）
DJANGO_SUPER_ADMIN_USERNAME=

# -----------------------------------------------------------------------------
# 关系型数据库（默认 django.db.backends.mysql / language_v2）
# -----------------------------------------------------------------------------
DB_ENGINE=django.db.backends.mysql
DB_NAME=language_v2
DB_USER=root
DB_PASSWORD=your-db-password-here
DB_HOST=localhost
DB_PORT=3306

# -----------------------------------------------------------------------------
# Redis（缓存 / 会话 / 限流 / 排行榜；默认 redis://127.0.0.1:6379/1）
# -----------------------------------------------------------------------------
REDIS_URL=redis://127.0.0.1:6379/1

# -----------------------------------------------------------------------------
# MongoDB（帖子快照 / 行为日志 / 评论嵌套；默认 mongodb://localhost:27017）
# -----------------------------------------------------------------------------
MONGODB_URI=mongodb://localhost:27017
MONGODB_NAME=language_nosql

# -----------------------------------------------------------------------------
# Neo4j（社交关系图谱；地址必须按部署环境配置）
# 默认 bolt://localhost:7687，不提供任何内网地址默认值
# -----------------------------------------------------------------------------
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# -----------------------------------------------------------------------------
# ChromaDB（语义搜索 / 内容推荐；默认 localhost:8000）
# -----------------------------------------------------------------------------
CHROMADB_HOST=localhost
CHROMADB_PORT=8000

# -----------------------------------------------------------------------------
# ELCat 源库（rebuild_from_elcat_sql.py 使用；独立于 language_v2）
# 用户名默认 root，密码默认复用 DB_PASSWORD，库名默认 elcat_source，端口默认 3306
# -----------------------------------------------------------------------------
ELCAT_DB_HOST=localhost
ELCAT_DB_PORT=3306
ELCAT_DB_USER=root
ELCAT_DB_PASSWORD=
ELCAT_DB_NAME=elcat_source

# -----------------------------------------------------------------------------
# 本地依赖路径
# -----------------------------------------------------------------------------
# 历史本地依赖目录（.pylibs 兜底；默认 ../.pylibs，缺失则忽略）
LOCAL_LIBS_DIR=

# -----------------------------------------------------------------------------
# 危险操作开关
# -----------------------------------------------------------------------------
# 数据库重建入口（`manage.py etl rebuild` / rebuild_from_elcat_sql.py）需要同时满足：
# 该变量为 1 且命令行附加 --confirm；默认 0，禁止随意开启
ALLOW_DESTRUCTIVE_DB_REBUILD=0

# -----------------------------------------------------------------------------
# 前端地图
# -----------------------------------------------------------------------------
# 高德地图前端 Key（留空则地图页显示降级提示）
# 说明：JS API 版本号（v=1.4.15）写在模板中，如升级 SDK 需同步修改模板
AMAP_JS_KEY=

# -----------------------------------------------------------------------------
# OpenAI / Moonshot 配置
# -----------------------------------------------------------------------------
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_BASE_URL=https://api.moonshot.cn/v1
# 模型名（当前账号可用：kimi-k2.7-code / kimi-k2.6 / kimi-k3；旧 moonshot-v1-8k 已下线）
OPENAI_MODEL=kimi-k2.7-code
# 推理模型通常要求 temperature=1（默认 1）
OPENAI_TEMPERATURE=1

# -----------------------------------------------------------------------------
# 联网搜索（Tavily）
# 未配置 Key 时自动降级：前端开关置灰并提示“未配置搜索服务”，页面不会报错。
# 免费档 1000 credits/月、100 RPM；每次搜索都会记录 query/耗时/成功状态。
# -----------------------------------------------------------------------------
SEARCH_ENABLED=true
SEARCH_PROVIDER=tavily
# 优先读取 SEARCH_API_KEY；留空时回退读取 TAVILY_API_KEY
SEARCH_API_KEY=
TAVILY_API_KEY=
SEARCH_BASE_URL=https://api.tavily.com
SEARCH_TIMEOUT=6
SEARCH_CONNECT_TIMEOUT=3
SEARCH_TOP_K=5
SEARCH_MAX_QUERY_CHARS=200
SEARCH_MAX_SNIPPET_CHARS=400
SEARCH_CACHE_TTL=600
SEARCH_EMPTY_CACHE_TTL=60
# 每日真实搜索拦截上限：0 或留空 = 不限制（开发阶段默认不拦截）。
# 每日/月度计数与日志仍然保留；Tavily 侧仍有 1000 credits/月、100 次/分钟硬限制。
SEARCH_DAILY_LIMIT=0
